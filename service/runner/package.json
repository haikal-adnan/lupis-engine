{
  "name": "lupis-runner",
  "version": "0.1.0",
  "author": "Haikal Adnan",
  "license": "MIT",
  "description": "Lupis Engine Standalone Runner",
  "main": "main.js",
  "devDependencies": {
    "electron": "^31.0.0"
  },
  "build": {
    "appId": "com.lupis.runner",
    "productName": "Lupis Engine Standalone",
    "compression": "normal",
    "asar": true,
    "removePackageScripts": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "icon.png"
    ],
    "win": {
      "target": ["portable"],
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    }
  }
}
